---
/**
 * contacto.astro — Página dedicada al formulario de contacto.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Contacto from '@components/Contacto.astro';
import FAQ from '@components/FAQ.astro';

const title = 'Contacto | Villatoro & Asociados — Abogados en Honduras';
const description =
  'Agende una consulta legal gratuita con el Bufete Jurídico Villatoro & Asociados. Atención en San Pedro Sula. Respuesta en menos de 24 horas.';
---

<BaseLayout title={title} description={description}>
  <Contacto compact={true} />
  <FAQ />
</BaseLayout>
